# Private message data. Never commit any of this.
# stats.json holds real names and AI-written notes about real friends, and
# this repo is public on GitHub -- it must never reach git history. The
# live Vercel site still gets the real file: see .vercelignore, which
# deploys stats.json straight from this laptop without going through git.
stats.json

# Same reasoning as stats.json above: this file maps real phone
# numbers/emails to your friends' real names. Copy lib/contactNames.example.js
# to lib/contactNames.js and fill in your own -- see that file for how.
# Like stats.json, this is NOT in .vercelignore, so the live site still
# shows real names; it's only kept out of git.
lib/contactNames.js
chat.db
chat.db-wal
chat.db-shm
*.db
*.db-wal
*.db-shm

# Python (legacy-flask-backend/)
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env/

# Node / Next.js
node_modules/
.next/
.vercel/

# Secrets -- Gemini API key and the /api/analyze secret live here, and this
# file must never be committed.
.env.local
.env*.local
.gstack/
.vercel
.env*
